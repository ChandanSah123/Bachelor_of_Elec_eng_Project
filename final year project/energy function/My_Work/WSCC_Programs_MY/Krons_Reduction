import psse3603
import psspy
import os
import re
import numpy as np
import scipy.io as sio

# ==============================================================================
# 1. SETUP
# ==============================================================================
work_dir = r"C:\Users\Acer\Desktop\final year project\energy function\My_Work\WSCC_Programs_MY"
result_dir=r"C:\Users\Acer\Desktop\final year project\energy function\My_Work\WSCC_Programs_MY\Result_Directory"
raw_file = os.path.join(work_dir, "IEEE9bus.raw")
txt_file = os.path.join(result_dir, "Ybus_Export.txt")
mat_file = os.path.join(result_dir, "Ybus_Export.mat")

psspy.psseinit(50)
psspy.read(0, raw_file)

# ==============================================================================
# 2. POWER FLOW
# ==============================================================================
print("Solving Power Flow...")
ierr = psspy.fnsl([0,0,0,1,1,0,99,0])
print(f"fnsl returned {ierr}")

# ==============================================================================
# 3. CONVERT
# ==============================================================================
print("Converting Generators...")
psspy.cong(0)

print("Converting Loads...")
psspy.conl(0,1,1,[0,0],[100,0,0,100])
psspy.conl(0,1,2,[0,0],[100,0,0,100])
psspy.conl(0,1,3,[0,0],[100,0,0,100])

psspy.ordr(0)
psspy.fact()
psspy.tysl(0)

# ==============================================================================
# 4. EXPORT Y-BUS AS TEXT
# ==============================================================================
print("Exporting Y-Bus...")
ierr_out = psspy.output_y_matrix(0,1,0,0,txt_file)
print(f"output_y_matrix returned {ierr_out}")

if ierr_out != 0:
    print("Error exporting Y-bus.")
    exit()

# ==============================================================================
# 5. BUILD NUMERIC Y-BUS
# ==============================================================================
print("Converting text file -> numeric Y-bus...")

Yreal = {}
Yimag = {}
max_bus = 0

with open(txt_file, "r") as f:
    for line in f:
        parts = re.findall(r"[-+]?\d*\.\d+|\d+", line)
        if len(parts) == 4:
            i = int(parts[0])
            j = int(parts[1])
            real = float(parts[2])
            imag = float(parts[3])

            max_bus = max(max_bus, i, j)

            Yreal[(i, j)] = real
            Yimag[(i, j)] = imag

# Build base matrix Y (9x9)
Y = np.zeros((max_bus, max_bus), dtype=complex)
for (i, j), val in Yreal.items():
    # Convert 1-based index to 0-based
    Y[i-1, j-1] = val + 1j * Yimag[(i, j)]

# ==============================================================================
# 6. AUGMENT AND REDUCE (MATCHING MATLAB LOGIC)
# ==============================================================================
print("Constructing Augmented Matrix and Performing Kron Reduction...")

# --- 6a. Define ybar and load_ybar (hardcoded from MATLAB) ---
# ybar = diag([-1i*16.45, -1i*8.35, -1i*5.52])
ybar = np.diag([0-16.45j, 0-8.35j, 0-5.52j])

# load_ybar (9x9)
load_ybar = np.zeros((9, 9), dtype=complex)
load_ybar[4, 4] = 1.26  - 0.504j  # Bus 5 (Index 4)
load_ybar[5, 5] = 0.877 - 0.292j  # Bus 6 (Index 5)
load_ybar[7, 7] = 0.969 - 0.339j  # Bus 8 (Index 7)

# --- 6b. Overwrite specific diagonals in Y (as per MATLAB) ---
# Y(5,5)=2.553-17.338i; -> Index 4
# Y(6,6)=3.224-15.841i; -> Index 5
# Y(8,8)=2.772-23.303i; -> Index 7
Y[4, 4] = 2.553 - 17.338j
Y[5, 5] = 3.224 - 15.841j
Y[7, 7] = 2.772 - 23.303j

# YN = Y (No change needed, Y is updated)
YN = Y

# --- 6c. Construct YN2 ---
# YNadd adds ybar to top-left 3x3 of Y
YNadd = np.zeros((9, 9), dtype=complex)
YNadd[0:3, 0:3] = ybar

YN1 = YN + YNadd
YN2 = YN1 + load_ybar

# --- 6d. Construct Y_aug (12x12) ---
# Structure:
# [ ybar    -ybar     0   ]
# [ -ybar   YN2(1:3)  ... ]
# [ 0       ...       ... ]

Y_aug = np.zeros((12, 12), dtype=complex)

# Top-Left (Internal Nodes 1-3): ybar
Y_aug[0:3, 0:3] = ybar

# Top-Middle (Coupling Internal <-> Physical 1-3): -ybar
Y_aug[0:3, 3:6] = -ybar

# Middle-Left (Transpose Coupling Physical <-> Internal): -ybar
Y_aug[3:6, 0:3] = -ybar

# Bottom-Right Block (Physical Network 1-9): YN2
Y_aug[3:12, 3:12] = YN2

# --- 6e. Kron Reduction to form Yint ---
# Yint = YA - YB * inv(YD) * YC
# YA = ybar (3x3)
YA = ybar

# YB (3x9) = [-ybar  0  0 ...]
YB = np.zeros((3, 9), dtype=complex)
YB[0:3, 0:3] = -ybar

# YC (9x3) = Transpose of YB
YC = np.zeros((9, 3), dtype=complex)
YC[0:3, 0:3] = -ybar

# YD = YN2 (9x9)
YD = YN2

print("Inverting YD (Physical Matrix)...")
try:
    # Solve YDC = YD \ YC  (Equivalent to inv(YD) * YC)
    YDC = np.linalg.solve(YD, YC)
    
    # Calculate Yint
    Yint = YA - np.dot(YB, YDC)
    
    print("Kron Reduction Successful.")
    print("Reduced Matrix Yint (3x3):")
    print(np.round(Yint, 4))
    
except np.linalg.LinAlgError:
    print("Error: YD matrix is singular. Kron reduction failed.")
    Yint = np.zeros((3, 3), dtype=complex)

# ==============================================================================
# 7. SAVE TO .MAT FILE
# ==============================================================================
print("Saving matrices to MATLAB format...")

# Saving Y (original), Y_aug (Augmented), and Yint (Reduced)
sio.savemat(mat_file, {
    "Ybus": Y, 
    "Y_aug": Y_aug, 
    "Yint": Yint
})

print(f"SUCCESS: Ybus_Export.mat created at:\n   {mat_file}")