%Formation of Admittance matrix, Kundur's Two Area System
bus=11;g=3;
Z=[1 4 0 0.0576 0
   2 7 0 0.0625 0
   3 9 0 0.0586 0
   4 5 0.01 0.085 0.088
   4 6 0.017 0.092 0.079
   5 7 0.032 0.161 0.153
   6 9 0.039 0.17 0.179
   7 8 0.0085 0.072 0.0745
   8 9 0.0119 0.1008 0.1045
   10 1 0 0.0608 0;
   11 2 0 0.1198 0
   12 3 0 0.1813 0];
Y1=zeros(12,12);
for k=1:11
    zl=Z(k,3)+1i*Z(k,4);
    Y1(Z(k,1),Z(k,2))=-(1/zl);
    Y1(Z(k,2),Z(k,1))=-(1/zl);
    Y1(Z(k,1),Z(k,1))=Y1(Z(k,1),Z(k,1))+(1/zl)+1i*Z(k,5);
    Y1(Z(k,2),Z(k,2))=Y1(Z(k,2),Z(k,2))+(1/zl)+1i*Z(k,5);
end
Y1(5,5)=Y1(5,5)+(1.25/(0.9728^2))-1i*(0.5/(0.9728^2));
Y1(6,6)=Y1(6,6)+(0.9/(0.989^2))-1i*(0.3/(0.989^2));
Y1(8,8)=Y1(8,8)+(1/(0.9972^2))-1i*(0.35/(0.9972^2));
Ynn=Y1(10:12,10:12); 
Ynr=Y1(10:12,1:9); 
Yrn=Y1(1:9,10:12); 
Yrr=Y1(1:9,1:9);
Yred=Ynn-((Ynr/Yrr)*Yrn);
Y1=Yred;